{
  "name": "landbase-automation-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node projects/landbase-e2e-tests/run-tests.js",
    "test:all": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts --project=chromium --headed --workers=1",
    "test:headless": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts --project=chromium --workers=1",
    "test:ui": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts --ui",
    "test:news": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts projects/landbase-e2e-tests/tests/news.spec.ts --project=chromium --headed --workers=1",
    "test:map": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts projects/landbase-e2e-tests/tests/map.spec.ts --project=chromium --headed --workers=1",
    "test:security": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts projects/landbase-e2e-tests/tests/security.spec.ts --project=chromium --headed --workers=1",
    "test:ads": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts projects/landbase-e2e-tests/tests/classified-ads.spec.ts --project=chromium --headed --workers=1",
    "test:api": "node projects/landbase-e2e-tests/run-tests.js --platform=3",
    "test:api:all": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts projects/landbase-e2e-tests/tests/api/ --project=api --headed --workers=1",
    "test:api:headless": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts projects/landbase-e2e-tests/tests/api/ --project=api --workers=1",
    "test:api:saved": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts projects/landbase-e2e-tests/tests/api/saved-real-estate.spec.ts --project=api --workers=1",
    "test:api:price": "playwright test --config=projects/landbase-e2e-tests/playwright.config.ts projects/landbase-e2e-tests/tests/api/land-price/ --project=api --workers=1",
    "token:get": "node projects/landbase-e2e-tests/scripts/capture-dev-tokens.js",
    "test:mobile": "wdio run projects/landbase-e2e-tests/wdio.conf.js",
    "test:mobile:auth": "wdio run projects/landbase-e2e-tests/wdio.conf.js --spec projects/landbase-e2e-tests/tests/mobile/app-auth.spec.ts",
    "test:mobile:profile": "wdio run projects/landbase-e2e-tests/wdio.conf.js --spec projects/landbase-e2e-tests/tests/mobile/app-profile.spec.ts",
    "test:mobile:news": "wdio run projects/landbase-e2e-tests/wdio.conf.js --spec projects/landbase-e2e-tests/tests/mobile/app-news.spec.ts",
    "test:mobile:ads": "wdio run projects/landbase-e2e-tests/wdio.conf.js --spec projects/landbase-e2e-tests/tests/mobile/app-classified-ads.spec.ts",
    "test:mobile:tools": "wdio run projects/landbase-e2e-tests/wdio.conf.js --spec projects/landbase-e2e-tests/tests/mobile/app-tools.spec.ts",
    "test:mobile:handbook": "wdio run projects/landbase-e2e-tests/wdio.conf.js --spec projects/landbase-e2e-tests/tests/mobile/app-handbook.spec.ts",
    "test:mobile:security": "wdio run projects/landbase-e2e-tests/wdio.conf.js --spec projects/landbase-e2e-tests/tests/mobile/app-security.spec.ts",
    "guide:capture": "node tools/landbase-user-guide/capture-screenshots.js",
    "guide:capture:missing": "node tools/landbase-user-guide/capture-missing.js",
    "guide:generate": "node tools/landbase-user-guide/generate-docx.js",
    "typecheck": "tsc --noEmit -p projects/landbase-e2e-tests/tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Automation workspace for LandBase projects and utilities",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@wdio/cli": "^8.46.0",
    "@wdio/local-runner": "^8.38.0",
    "@wdio/mocha-framework": "^8.38.0",
    "@wdio/spec-reporter": "^8.38.0",
    "appium": "^2.11.3",
    "appium-uiautomator2-driver": "^3.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "wdio-html-nice-reporter": "^8.1.7",
    "webdriverio": "^8.38.0"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "xlsx": "^0.18.5"
  }
}
